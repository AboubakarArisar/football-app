# Server Configuration
PORT=3000

# Session Configuration
SESSION_SECRET=your_super_secret_key_change_this_in_production

# MongoDB Atlas Configuration
# Get your connection string from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/football-app?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/football-app?retryWrites=true&w=majority

# Tunneling Configuration
# Set ENABLE_TUNNEL=true to automatically start tunnel when server starts
ENABLE_TUNNEL=false

# Optional: Ngrok auth token (for custom domains and more features)
# NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
