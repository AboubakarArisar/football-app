<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Football Tournament</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .error-container {
      max-width: 500px;
      margin: 100px auto;
      padding: 30px;
      text-align: center;
      background-color: #fadbd8;
      border: 2px solid #e74c3c;
      border-radius: 8px;
    }

    .error-container h1 {
      color: #c0392b;
      margin-top: 0;
    }

    .error-container p {
      color: #a93226;
      font-size: 16px;
    }

    .btn-home {
      padding: 12px 30px;
      background-color: #2ecc71;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      font-size: 16px;
      margin-top: 20px;
    }

    .btn-home:hover {
      background-color: #27ae60;
    }
  </style>
</head>
<body>
  <div class="error-container">
    <h1>⚠️ Error</h1>
    <p>{{error}}</p>
    <a href="/" class="btn-home">← Go Home</a>
  </div>
</body>
</html>
