<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Football Tournament</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    .dashboard-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 20px;
    }

    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      border-bottom: 2px solid #2ecc71;
      padding-bottom: 20px;
    }

    .dashboard-header h1 {
      color: #27ae60;
      margin: 0;
    }

    .user-info {
      display: flex;
      gap: 15px;
      align-items: center;
    }

    .user-greeting {
      color: #2c3e50;
      font-weight: bold;
    }

    .btn-logout {
      padding: 10px 20px;
      background-color: #e74c3c;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
    }

    .btn-logout:hover {
      background-color: #c0392b;
    }

    .create-tournament-section {
      margin-bottom: 30px;
      padding: 20px;
      background-color: #ecf0f1;
      border-radius: 8px;
    }

    .create-tournament-section h2 {
      color: #27ae60;
      margin-top: 0;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
      color: #2c3e50;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #bdc3c7;
      border-radius: 4px;
      font-size: 14px;
      box-sizing: border-box;
      font-family: inherit;
    }

    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }

    .btn-create {
      padding: 12px 30px;
      background-color: #2ecc71;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
      font-weight: bold;
    }

    .btn-create:hover {
      background-color: #27ae60;
    }

    .tournaments-section h2 {
      color: #27ae60;
      margin-bottom: 20px;
    }

    .tournaments-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }

    .tournament-card {
      border: 1px solid #bdc3c7;
      border-radius: 8px;
      padding: 20px;
      background-color: white;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .tournament-card h3 {
      color: #27ae60;
      margin-top: 0;
    }

    .tournament-card p {
      color: #7f8c8d;
      margin: 10px 0;
    }

    .tournament-status {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .tournament-status.draft {
      background-color: #ecf0f1;
      color: #2c3e50;
    }

    .tournament-status.active {
      background-color: #2ecc71;
      color: white;
    }

    .tournament-status.finished {
      background-color: #95a5a6;
      color: white;
    }

    .tournament-actions {
      display: flex;
      gap: 10px;
      margin-top: 15px;
    }

    .btn-small {
      padding: 8px 15px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 14px;
      flex: 1;
      text-align: center;
      text-decoration: none;
      display: inline-block;
    }

    .btn-view {
      background-color: #3498db;
      color: white;
    }

    .btn-view:hover {
      background-color: #2980b9;
    }

    .btn-start {
      background-color: #2ecc71;
      color: white;
    }

    .btn-start:hover {
      background-color: #27ae60;
    }

    .empty-message {
      text-align: center;
      color: #95a5a6;
      padding: 30px;
      font-size: 18px;
    }
  </style>
</head>
<body>
  <div class="dashboard-container">
    <div class="dashboard-header">
      <h1>⚽ Tournament Dashboard</h1>
      <div class="user-info">
        <span class="user-greeting">Welcome, {{username}}!</span>
        <a href="/logout" class="btn-logout">Logout</a>
      </div>
    </div>

    <div class="create-tournament-section">
      <h2>Create New Tournament</h2>
      <form id="tournamentForm">
        <div class="form-group">
          <label for="tournamentName">Tournament Name</label>
          <input type="text" id="tournamentName" name="name" required>
        </div>

        <div class="form-group">
          <label for="tournamentDescription">Description (Optional)</label>
          <textarea id="tournamentDescription" name="description"></textarea>
        </div>

        <button type="submit" class="btn-create">Create Tournament</button>
        <span id="createMessage"></span>
      </form>
    </div>

    <div class="tournaments-section">
      <h2>Your Tournaments</h2>
      {{#if tournaments}}
        <div class="tournaments-list">
          {{#each tournaments}}
            <div class="tournament-card">
              <h3>{{this.name}}</h3>
              <span class="tournament-status {{this.status}}">{{#replace this.status '_' ' '}}{{uppercase this}}{{/replace}}</span>
              {{#if this.description}}
                <p>{{this.description}}</p>
              {{/if}}
              <p><strong>Created:</strong> {{this.created_at}}</p>
              <div class="tournament-actions">
                {{#eq this.status 'draft'}}
                  <button class="btn-small btn-start" onclick="startTournament({{this.id}})">Start Tournament</button>
                {{/eq}}
                {{#eq this.status 'active'}}
                  <a href="/tournament/{{this.id}}" class="btn-small btn-view">Manage</a>
                  <button class="btn-small btn-start" onclick="finishTournament({{this.id}})">Finish</button>
                {{/eq}}
                {{#eq this.status 'finished'}}
                  <a href="/tournament/{{this.id}}/view" class="btn-small btn-view">View Results</a>
                {{/eq}}
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-message">
          No tournaments yet. Create one above to get started!
        </div>
      {{/if}}
    </div>
  </div>

  <script>
    document.getElementById('tournamentForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('tournamentName').value;
      const description = document.getElementById('tournamentDescription').value;
      const message = document.getElementById('createMessage');

      try {
        const response = await fetch('/api/tournaments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description })
        });

        const data = await response.json();
        if (data.success || data.tournament_id) {
          message.textContent = 'Tournament created! Refreshing...';
          message.style.color = '#2ecc71';
          setTimeout(() => window.location.reload(), 1000);
        } else {
          message.textContent = 'Error: ' + data.error;
          message.style.color = '#e74c3c';
        }
      } catch (error) {
        message.textContent = 'Error: ' + error.message;
        message.style.color = '#e74c3c';
      }
    });

    async function startTournament(id) {
      try {
        const response = await fetch(`/api/tournaments/${id}/start`, { method: 'POST' });
        const data = await response.json();
        if (data.success) {
          window.location.reload();
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    }

    async function finishTournament(id) {
      if (confirm('Are you sure you want to finish this tournament?')) {
        try {
          const response = await fetch(`/api/tournaments/${id}/finish`, { method: 'POST' });
          const data = await response.json();
          if (data.success) {
            window.location.reload();
          }
        } catch (error) {
          alert('Error: ' + error.message);
        }
      }
    }
  </script>
</body>
</html>
